{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src", "test", "bin"]
}
