# Copy to packages/nextjs/.env.local. Everything without NEXT_PUBLIC_ stays on the server.

# --- Trading (Lambdaplex, mainnet) ---
# Create an API key in the Lambdaplex app (Ed25519). Paste the key id and its private key
# (base64 PKCS#8, PEM, or 32-byte hex seed). Never commit these.
LAMBDAPLEX_API_KEY=
LAMBDAPLEX_PRIVATE_KEY=
# Orders are refused unless this is true, even with keys present. Keep it false on hosted demos.
TRADING_ENABLED=false

# --- Track record (Hedera Consensus Service) ---
# Operator that pays for and signs HCS messages (create the topic with `yarn lambdaplex:topic:create`).
# DER keys of either curve work as-is; for a raw hex key set HEDERA_OPERATOR_KEY_TYPE (ECDSA by default).
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_OPERATOR_KEY_TYPE=ECDSA
TRACK_RECORD_TOPIC_ID=
NEXT_PUBLIC_TRACK_RECORD_TOPIC_ID=
STRATEGY_NAME=twap-hbar-usdc

# --- Frontend ---
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Where /bots runs TWAP jobs. Unset: in the background on a long-running server, inline (dry runs only) when VERCEL
# is set, because serverless functions can't host background jobs. Force either with inline | background.
# TWAP_JOBS=
