{
  "name": "lambdaplex-terminal-yarn",
  "description": "Install, test, lint and build. No secrets or network funds needed.",
  "requiresNoSecrets": true,
  "forbiddenCommands": ["npm install", "npm run", "pnpm install", "pnpm run"],
  "commands": [
    { "name": "install", "command": "yarn install", "timeoutMs": 900000, "purpose": "Install workspace dependencies." },
    { "name": "sdk", "command": "yarn lambdaplex:test", "timeoutMs": 300000, "purpose": "SDK unit tests." },
    { "name": "contracts", "command": "yarn foundry:test", "timeoutMs": 300000, "purpose": "StrategyRegistry tests." },
    { "name": "frontend-tests", "command": "yarn next:test", "timeoutMs": 180000, "purpose": "Vitest for utils." },
    { "name": "types", "command": "yarn next:check-types", "timeoutMs": 300000, "purpose": "TypeScript." },
    { "name": "lint", "command": "yarn lint", "timeoutMs": 300000, "purpose": "ESLint, Prettier, forge fmt, tsc." },
    { "name": "build", "command": "yarn next:build", "timeoutMs": 600000, "purpose": "Production build." }
  ]
}
